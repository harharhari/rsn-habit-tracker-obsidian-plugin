<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="habit-architecture" name="Habit Calendar 001b"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Habit Calendar 001b — confirmed current-month resets and frozen history" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1100" height="50" /></mxCell><mxCell id="list" value="habit-tracker-list.md&#10;Habit | Y/N | Header color&#10;Copy codes from hex-color-list.md" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="130" width="300" height="100" /></mxCell><mxCell id="plugin" value="Obsidian 001b&#10;List changed → Yes/No dialog&#10;Yes: rebuild and clear all marks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="130" width="300" height="100" /></mxCell><mxCell id="timer" value="Primary Linux timer + Python&#10;Checks current month every minute&#10;Works while Obsidian is closed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="130" width="300" height="100" /></mxCell><mxCell id="events" value="Records/YYYY-MM/UUID.md&#10;Create / reset / generation-tagged marks&#10;Late old-revision marks are excluded" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="340" width="300" height="120" /></mxCell><mxCell id="pages" value="Monthly note + custom view&#10;2026-10 October 2026&#10;Six columns desktop; one mobile" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;s